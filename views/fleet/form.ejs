<h1><%= title %></h1>
<% if (error) { %><p class="alert err"><%= error %></p><% } %>
<div class="card">
  <form method="post" action="<%= action %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h2 style="margin-top:0">Unit</h2>
    <div class="filters">
      <label>Unit number * <input type="text" name="unit_number" value="<%= unit ? unit.unit_number || '' : '' %>" required maxlength="40" placeholder="e.g. T-102"></label>
      <label>Type <select name="unit_type">
        <% unitTypes.forEach((t) => { %><option value="<%= t %>" <%= unit && unit.unit_type === t ? 'selected' : '' %>><%= t %></option><% }) %></select></label>
      <label>Description <input type="text" name="description" value="<%= unit ? unit.description || '' : '' %>" maxlength="200" placeholder="e.g. 7,500-gal fuel tanker"></label>
    </div>
    <h2>Identity</h2>
    <div class="filters">
      <label>Make <input type="text" name="make" value="<%= unit ? unit.make || '' : '' %>" maxlength="60" placeholder="e.g. Heil"></label>
      <label>Model year <input type="number" name="model_year" value="<%= unit ? unit.model_year || '' : '' %>" min="1950" max="2100" placeholder="e.g. 2021"></label>
      <label>VIN <input type="text" name="vin" value="<%= unit ? unit.vin || '' : '' %>" maxlength="40"></label>
      <label>Plate <input type="text" name="plate" value="<%= unit ? unit.plate || '' : '' %>" maxlength="20"></label>
    </div>
    <h2>Specs</h2>
    <div class="filters">
      <label>Tire size <input type="text" name="tire_size" value="<%= unit ? unit.tire_size || '' : '' %>" maxlength="40" placeholder="e.g. 11R22.5"></label>
      <label>Tire brand <input type="text" name="tire_brand" value="<%= unit ? unit.tire_brand || '' : '' %>" maxlength="60"></label>
      <label>Axles <input type="number" name="axles" value="<%= unit ? unit.axles || '' : '' %>" min="1" max="10"></label>
      <label>Capacity (gallons) <input type="number" name="capacity_gallons" value="<%= unit ? unit.capacity_gallons || '' : '' %>" min="0" step="0.1"></label>
    </div>
    <h2>Annual inspection</h2>
    <div class="filters">
      <label>Last inspection date <input type="date" name="last_inspection_date" value="<%= unit ? unit.last_inspection_date || '' : '' %>"></label>
      <label>Next due date <input type="date" name="inspection_due_date" value="<%= unit ? unit.inspection_due_date || '' : '' %>"></label>
    </div>
    <p class="muted">Leave “Next due” blank and it is set automatically to one year after the last inspection — that date drives the inspection reminders.</p>
    <h2>Notes</h2>
    <label style="display:block">Notes <textarea name="notes" rows="3" maxlength="2000" style="width:100%"><%= unit ? unit.notes || '' : '' %></textarea></label>
    <p><button class="btn-primary" type="submit">Save unit</button>
    <a class="btn" href="<%= unit && unit.id ? '/fleet/units/' + unit.id : '/fleet' %>">Cancel</a></p>
  </form>
</div>

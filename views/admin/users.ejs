<% const title = 'Users'; %>
<h1>Users</h1>
<% if (error) { %><p class="alert err"><%= error %></p><% } %>
<% if (msg) { %><p class="alert ok"><%= msg %></p><% } %>
<div class="card">
  <h2 style="margin-top:0">Add user</h2>
  <form method="post" action="/admin/users">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="filters">
      <label>Name <input type="text" name="name" required maxlength="120"></label>
      <label>Email <input type="email" name="email" required></label>
      <label>Password (4–12) <input type="password" name="password" required minlength="4" maxlength="12"></label>
      <label>Role <select name="role"><option value="driver">Driver</option><option value="admin">Admin (office)</option></select></label>
    </div>
    <p><button class="btn-primary" type="submit">Create user</button></p>
  </form>
</div>
<div class="card">
  <table class="grid">
    <tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th></th></tr>
    <% users.forEach((u) => { %>
      <tr>
        <td><%= u.name %></td><td><%= u.email %></td><td><%= u.role %></td>
        <td><% if (u.active) { %><span class="badge">active</span><% } else { %><span class="badge off">disabled</span><% } %>
          <% if (online[u.id]) { %> <span class="badge" style="background:#e6f7ec;color:#0a7a2f">● online</span><% } %></td>
        <td><div class="rowbtns">
          <form method="post" action="/admin/users/<%= u.id %>/toggle" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-sm" type="submit" <%= u.email === user.email ? 'disabled' : '' %>><%= u.active ? 'Disable' : 'Enable' %></button></form>
          <form method="post" action="/admin/users/<%= u.id %>/role" class="inline"
                onsubmit="return confirm('Change <%= u.name.replace(/'/g, "\\'") %> from <%= u.role %> to <%= u.role === 'admin' ? 'driver' : 'admin' %>? They will be signed out and must log in again.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-sm" type="submit" <%= u.email === user.email ? 'disabled' : '' %>><%= u.role === 'admin' ? 'Make driver' : 'Make admin' %></button></form>
          <form method="post" action="/admin/users/<%= u.id %>/logout" class="inline"
                onsubmit="return confirm('Log <%= u.name.replace(/'/g, "\\'") %> out on every device? They will have to sign in again.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-sm" type="submit" <%= u.email === user.email ? 'disabled' : '' %>>Log out</button></form>
          <form method="post" action="/admin/users/<%= u.id %>/reset-password" class="inline" onsubmit="return setPw(this)"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-sm" type="submit">Reset password</button></form>
          <form method="post" action="/admin/users/<%= u.id %>/delete" class="inline"
                onsubmit="return confirm('Delete <%= u.name.replace(/'/g, "\\'") %> permanently? This only works if they have no fills or jobs on record.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-sm btn-danger" type="submit" <%= u.email === user.email ? 'disabled' : '' %>>Delete</button></form>
        </div></td>
      </tr>
    <% }) %>
  </table>
</div>
<script>
function setPw(form) {
  var pw = prompt('Enter the new password (4–12 characters):');
  if (!pw || pw.length < 4 || pw.length > 12) { alert('Password must be 4–12 characters.'); return false; }
  var i = document.createElement('input');
  i.type = 'hidden'; i.name = 'password'; i.value = pw;
  form.appendChild(i);
  return true;
}
</script>

<% const title = 'Ledger — ' + data.customer.name; %>
<% if (emailed) { %><div class="alert ok noprint"><%= emailed %></div><% } %>
<% if (emailerr) { %><div class="alert err noprint"><%= emailerr %></div><% } %>
<div class="noprint" style="margin-bottom:1rem">
  <a href="/admin/ledger">← Back to builder</a>
  <div class="rowbtns" style="margin-top:.6rem">
    <a class="btn-primary" href="/admin/ledger/pdf?<%= q %>">Download PDF</a>
    <a class="btn" href="/admin/ledger/csv?<%= q %>">Download CSV</a>
    <button class="btn" type="button" id="copybtn">Copy as text</button>
    <button class="btn" type="button" onclick="window.print()">Print</button>
  </div>
</div>

<details class="card noprint" style="margin-bottom:1rem">
  <summary style="cursor:pointer;font-weight:600">✉️ Email this ledger (PDF attached)</summary>
  <% if (!emailConfigured) { %>
    <p class="muted">Email is not configured on this server. Set <code>SMTP_HOST</code> (plus
    <code>SMTP_USER</code>/<code>SMTP_PASS</code>/<code>SMTP_FROM</code>) in the environment and restart to enable it.</p>
  <% } else { %>
    <form method="post" action="/admin/ledger/email" style="margin-top:.6rem">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="customer_id" value="<%= data.customer.id %>">
      <input type="hidden" name="from" value="<%= data.from || '' %>">
      <input type="hidden" name="to" value="<%= data.to || '' %>">
      <label>Recipients (comma or semicolon separated, up to 20)
        <input type="text" name="recipients" required placeholder="ap@customer.com, billing@customer.com"
               value="<%= data.customer.billing_email ? data.customer.billing_email : '' %>">
      </label>
      <label>Subject
        <input type="text" name="subject" value="<%= defaultSubject %>" maxlength="200">
      </label>
      <label>Message
        <textarea name="message" rows="3" maxlength="5000"><%= defaultMessage %></textarea>
      </label>
      <button class="btn-primary" type="submit">Send ledger email</button>
    </form>
  <% } %>
</details>

<div class="card">
  <% if (company.company_name) { %><h1 style="margin-bottom:0"><%= company.company_name %></h1><% } %>
  <% if (company.company_phone || company.company_email) { %><div class="muted"><%= [company.company_phone, company.company_email].filter(Boolean).join(' · ') %></div><% } %>
  <% if (company.company_address) { %><div class="muted"><%= company.company_address %></div><% } %>
  <h2>Fuel Delivery Ledger</h2>
  <p><strong>Customer:</strong> <%= data.customer.name %><br>
  <strong>Period:</strong> <%= data.from || 'beginning' %> to <%= data.to || 'today' %></p>
  <div style="overflow-x:auto">
  <table class="grid">
    <tr><th>Date</th><th>Site</th><th>Equipment</th><th>Fuel type</th><th class="num">Gallons</th><th>Driver</th></tr>
    <% data.fills.forEach((f) => { %>
      <tr><td><%= fmtDateTime(f.filled_at) %></td><td><%= f.site_name || '—' %></td><td><%= f.equipment_label %></td>
      <td><%= f.fuel_type %></td><td class="num"><%= fmtGal(f.gallons) %></td><td><%= f.driver_name %></td></tr>
    <% }) %>
  </table>
  </div>
  <h2>Totals by fuel type</h2>
  <table class="grid">
    <% data.totals.forEach((t) => { %>
      <tr><td><%= t.fuel_type %></td><td class="num"><%= t.n %> fills</td><td class="num"><strong><%= fmtGal(t.gal) %> gal</strong></td></tr>
    <% }) %>
    <tr><td><strong>Grand total</strong></td><td class="num"><strong><%= data.fills.length %> fills</strong></td><td class="num"><strong><%= fmtGal(data.grand) %> gal</strong></td></tr>
  </table>
</div>

<pre class="ledger noprint" id="ledgertext" style="white-space:pre-wrap"><%= text %></pre>

<script>
document.getElementById('copybtn').addEventListener('click', function () {
  var t = document.getElementById('ledgertext').textContent;
  navigator.clipboard.writeText(t).then(function () {
    var b = document.getElementById('copybtn');
    b.textContent = 'Copied ✓'; setTimeout(function () { b.textContent = 'Copy as text'; }, 2000);
  });
});
</script>

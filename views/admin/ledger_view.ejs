<% const title = 'Ledger — ' + data.customer.name; %>
<div class="noprint" style="margin-bottom:1rem">
  <a href="/admin/ledger">← Back to builder</a>
  <div class="rowbtns" style="margin-top:.6rem">
    <a class="btn-primary" href="/admin/ledger/pdf?<%= q %>">Download PDF</a>
    <a class="btn" href="/admin/ledger/csv?<%= q %>">Download CSV</a>
    <button class="btn" type="button" id="sharebtn" style="display:none">Share…</button>
    <button class="btn" type="button" id="copybtn">Copy as text</button>
    <button class="btn" type="button" onclick="window.print()">Print</button>
  </div>
  <% if (blind) { %><p class="muted" style="margin-top:.5rem">Blind shipment version — the customer's name only; your company info is hidden on the printed ledger, PDF, and text.</p><% } %>
</div>


<div class="card">
  <% if (blind) { %>
  <h1 style="margin-bottom:0"><%= data.customer.name %></h1>
  <% } else { %>
  <% if (company.company_name) { %><h1 style="margin-bottom:0"><%= company.company_name %></h1><% } %>
  <% if (company.company_phone || company.company_email) { %><div class="muted"><%= [company.company_phone, company.company_email].filter(Boolean).join(' · ') %></div><% } %>
  <% if (company.company_address) { %><div class="muted"><%= company.company_address %></div><% } %>
  <% } %>
  <h2>Fuel Delivery Ledger</h2>
  <p><% if (!blind) { %><strong>Customer:</strong> <%= data.customer.name %><br><% } %>
  <% if (data.site) { %><strong>Site:</strong> <%= data.site.name %><br><% } %>
  <strong>Period:</strong> <%= data.from || 'beginning' %> to <%= data.to || 'today' %></p>
  <div style="overflow-x:auto">
  <table class="grid">
    <tr><th>Date</th><th>Site</th><th>Equipment</th><th>Fuel type</th><th>BOL #</th><th class="num">Gallons</th><th>Driver</th><th>BOL</th></tr>
    <% data.fills.forEach((f) => { %>
      <tr><td><%= fmtDateTime(f.filled_at) %></td><td><%= f.site_name || '—' %></td><td><%= f.equipment_label %></td>
      <td><%= f.fuel_type %></td><td><%= f.bol_number || '—' %></td><td class="num"><%= fmtGal(f.gallons) %></td><td><%= f.driver_name %></td>
      <td><% if (Number(f.bol_count) > 0) { %><a href="/admin/entries/<%= f.id %>">BOL ×<%= f.bol_count %></a><% } else { %><span class="muted">—</span><% } %></td></tr>
    <% }) %>
  </table>
  </div>
  <h2>Totals by fuel type</h2>
  <table class="grid">
    <% data.totals.forEach((t) => { %>
      <tr><td><%= t.fuel_type %></td><td class="num"><%= t.n %> fills</td><td class="num"><strong><%= fmtGal(t.gal) %> gal</strong></td></tr>
    <% }) %>
  </table>
</div>

<% if (data.byDriver && data.byDriver.length > 1) { %>
<div class="card">
  <h2>Totals by driver</h2>
  <table class="grid">
    <% data.byDriver.forEach((d) => { %>
      <tr><td><%= d.driver_name %></td><td class="num"><%= d.n %> fills</td><td class="num"><strong><%= fmtGal(d.gal) %> gal</strong></td></tr>
    <% }) %>
  </table>
</div>
<% } %>

<pre class="ledger noprint" id="ledgertext" style="white-space:pre-wrap"><%= text %></pre>

<script>
document.getElementById('copybtn').addEventListener('click', function () {
  var t = document.getElementById('ledgertext').textContent;
  navigator.clipboard.writeText(t).then(function () {
    var b = document.getElementById('copybtn');
    b.textContent = 'Copied ✓'; setTimeout(function () { b.textContent = 'Copy as text'; }, 2000);
  });
});
// Native share sheet (phones): sends the ledger PDF through the user's own
// email/messaging apps — no server email configuration needed.
(function () {
  var btn = document.getElementById('sharebtn');
  if (!btn || !navigator.share || !navigator.canShare) return;
  btn.style.display = '';
  btn.addEventListener('click', function () {
    btn.disabled = true;
    fetch('/admin/ledger/pdf?<%- q %>', { credentials: 'same-origin' }).then(function (res) {
      if (!res.ok) throw new Error('download failed');
      var disp = res.headers.get('Content-Disposition') || '';
      var m = /filename="([^"]+)"/.exec(disp);
      return res.blob().then(function (blob) {
        return new File([blob], m ? m[1] : 'fuel-ledger.pdf', { type: 'application/pdf' });
      });
    }).then(function (file) {
      if (!navigator.canShare({ files: [file] })) throw new Error('cannot share files');
      return navigator.share({ files: [file], title: 'Fuel delivery ledger', text: 'Fuel delivery ledger (PDF attached)' });
    }).catch(function (e) {
      if (!e || e.name !== 'AbortError') alert('Sharing is not available on this device — use Download PDF instead.');
    }).then(function () { btn.disabled = false; });
  });
})();
</script>

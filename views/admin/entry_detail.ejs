<% const title = 'Fill #' + x.id; %>
<h1>Fill #<%= x.id %></h1>
<p class="muted"><%= fmtDateTime(x.filled_at) %> · logged by <%= x.driver_name %></p>
<p><a class="btn btn-sm" href="/admin/entries/<%= x.id %>/edit">Edit entry</a>
  <form method="post" action="/admin/entries/<%= x.id %>/delete" class="inline" onsubmit="return confirm('Delete this entry? This cannot be undone.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <button class="btn btn-sm" type="submit">Delete entry</button></form>
  <a class="btn btn-sm" href="/admin/entries">Back to log</a></p>

<div class="card">
  <h2 style="margin-top:0">Details</h2>
  <p><strong>Customer:</strong> <%= x.customer_name %><br>
     <strong>Site:</strong> <%= x.site_name || '—' %><br>
     <strong>Equipment:</strong> <%= x.equipment_label %><br>
     <strong>Fuel:</strong> <%= x.fuel_type %><br>
     <strong>BOL #:</strong> <%= x.bol_number || '—' %><br>
     <strong>Gallons:</strong> <%= fmtGal(x.gallons) %><br>
     <strong>Notes:</strong> <%= x.notes || '—' %><br>
     <% if (x.latitude != null && x.longitude != null) { %>
     <strong>GPS:</strong> <%= Number(x.latitude).toFixed(5) %>, <%= Number(x.longitude).toFixed(5) %>
       <% if (x.location_accuracy != null) { %><span class="muted">(±<%= Math.round(x.location_accuracy) %> m)</span><% } %>
       · <a href="https://www.google.com/maps?q=<%= x.latitude %>,<%= x.longitude %>" target="_blank" rel="noopener">View map</a>
     <% } else { %><strong>GPS:</strong> <span class="muted">not captured</span><% } %></p>
</div>

<div class="card">
  <h2 style="margin-top:0">BOL photos</h2>
  <% if (!docs.length) { %>
    <p class="muted">No BOL photos attached to this fill.</p>
  <% } else { %>
    <div style="display:flex;flex-wrap:wrap;gap:1rem">
      <% docs.forEach((d) => { const url = '/admin/entries/' + x.id + '/documents/' + d.id; %>
        <figure style="margin:0;width:200px">
          <a href="<%= url %>" target="_blank" rel="noopener">
            <img src="<%= url %>" alt="BOL photo"
                 style="width:200px;height:140px;object-fit:cover;border:1px solid var(--line);border-radius:8px;background:#f5f5f5">
          </a>
          <figcaption style="font-size:.8rem;margin-top:.3rem">
            <strong>BOL photo</strong><br>
            <span class="muted"><%= (d.size_bytes / 1024).toFixed(0) %> KB</span> ·
            <a href="<%= url %>" target="_blank" rel="noopener">View</a> ·
            <a href="<%= url %>?download=1">Download</a>
          </figcaption>
        </figure>
      <% }) %>
    </div>
  <% } %>
</div>

<p><a href="/admin/entries">← Back to entry log</a></p>

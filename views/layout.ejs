<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>Fuel Ledger Pro</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="topbar">
  <a class="brand" href="/">⛽ Fuel Ledger Pro</a>
  <% if (user) { %>
  <nav>
    <% if (user.role === 'driver') { %>
      <a href="/driver">Home</a>
      <a href="/driver/fills/new" class="btn-primary">+ Log fill</a>
      <a href="/driver/fills">My fills</a>
      <a href="/driver/schedule">My schedule</a>
    <% } else { %>
      <a href="/admin">Dashboard</a>
      <a href="/admin/entries">Entries</a>
      <a href="/admin/ledger">Ledger</a>
      <a href="/admin/dispatch">Dispatch</a>
      <a href="/admin/customers">Customers</a>
      <a href="/admin/import">Import</a>
      <a href="/admin/settings">Settings</a>
      <a href="/admin/users">Users</a>
    <% } %>
    <span class="who"><%= user.name %> (<%= user.role %>)</span>
    <form method="post" action="/logout" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="linklike" type="submit">Log out</button></form>
  </nav>
  <% } %>
</header>
<main class="wrap">
  <%- body %>
</main>
<footer class="foot">Fuel Ledger Pro · all times are local business time</footer>
</body>
</html>

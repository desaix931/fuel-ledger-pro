<% const title = editing ? 'Edit fill' : 'Log a fill'; %>
<h1><%= editing ? 'Edit fill' : 'Log a fill' %></h1>
<% if (errors && errors.length) { %><div class="alert err"><% errors.forEach((e) => { %><div><%= e %></div><% }) %></div><% } %>

<form method="post" action="<%= formAction %>" id="fillform" enctype="multipart/form-data">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (editing) { %>
  <input type="hidden" name="latitude" value="<%= editing.latitude == null ? '' : editing.latitude %>">
  <input type="hidden" name="longitude" value="<%= editing.longitude == null ? '' : editing.longitude %>">
  <input type="hidden" name="location_accuracy" value="<%= editing.location_accuracy == null ? '' : editing.location_accuracy %>">
  <% } else { %>
  <input type="hidden" name="latitude" id="fill_lat">
  <input type="hidden" name="longitude" id="fill_lng">
  <input type="hidden" name="location_accuracy" id="fill_acc">
  <% } %>
  <p id="gpsbadge" class="muted" style="display:none;font-size:.85rem">📍 Location captured</p>

  <% if (isAdmin && drivers && drivers.length) { %>
  <div class="card">
    <label>Driver — who performed this fill
      <select name="driver_id" required>
        <% drivers.forEach((d) => { %>
          <option value="<%= d.id %>" <%= String(form.driver_id || user.id) === String(d.id) ? 'selected' : '' %>><%= d.name %> · <%= d.role %></option>
        <% }) %>
      </select>
    </label>
  </div>
  <% } %>

  <div class="card">
    <label>Customer
      <select name="customer_id" id="customer" required>
        <option value="">— pick customer —</option>
        <% lookups.customers.forEach((c) => { %>
          <option value="<%= c.id %>" <%= String(form.customer_id) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
        <% }) %>
      </select>
    </label>
    <label>Site
      <select name="site_id" id="site">
        <option value="">— no site / other —</option>
        <% lookups.sites.forEach((s) => { %>
          <option value="<%= s.id %>" data-customer="<%= s.customer_id %>" <%= String(form.site_id) === String(s.id) ? 'selected' : '' %>><%= s.customer_name %> — <%= s.name %></option>
        <% }) %>
      </select>
    </label>
    <label>Equipment
      <input type="text" name="equipment_label" id="equipment" required maxlength="120"
             placeholder="e.g. Gen 3" value="<%= form.equipment_label || '' %>" autocomplete="off">
    </label>
    <% if (lookups.recentEquipment.length) { %>
      <div class="muted" style="font-size:.85rem">Tap to reuse:</div>
      <div class="chips" id="eqchips">
        <% lookups.recentEquipment.forEach((e) => { %>
          <button type="button" class="chip" data-eq="<%= e %>"><%= e %><span class="chipx" data-del data-kind="equipment" data-val="<%= e %>" title="Remove from quick pick">×</span></button>
        <% }) %>
      </div>
    <% } %>
    <label>BOL number <span class="muted" style="font-weight:400">(from the fuel source)</span>
      <input type="text" name="bol_number" id="bolnumber" maxlength="60" autocomplete="off"
             placeholder="e.g. 88410237" value="<%= form.bol_number || '' %>">
    </label>
    <% if (lookups.recentBolNumbers && lookups.recentBolNumbers.length) { %>
      <div class="muted" style="font-size:.85rem">Tap to reuse:</div>
      <div class="chips" id="bolchips">
        <% lookups.recentBolNumbers.forEach((b) => { %>
          <button type="button" class="chip" data-bol="<%= b %>"><%= b %><span class="chipx" data-del data-kind="bol" data-val="<%= b %>" title="Remove from quick pick">×</span></button>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div class="card">
    <label>Fuel type
      <select name="fuel_type" id="fueltype" required>
        <% FUEL_TYPES.forEach((t) => { %>
          <option value="<%= t %>" <%= form.fuel_type === t ? 'selected' : '' %>><%= t %></option>
        <% }) %>
        <option value="__custom" <%= form.fuel_type === '__custom' ? 'selected' : '' %>>Custom…</option>
      </select>
    </label>
    <label id="customfuelwrap" style="display:<%= form.fuel_type === '__custom' ? 'block' : 'none' %>">Custom fuel type
      <input type="text" name="fuel_type_custom" maxlength="60" value="<%= form.fuel_type_custom || '' %>">
    </label>
    <label>Gallons
      <input type="number" name="gallons" id="gallons" required min="0.01" step="0.01" inputmode="decimal"
             placeholder="0.00" value="<%= form.gallons || '' %>" style="font-size:1.4rem;font-weight:700">
    </label>
    <div class="galpad" id="galpad">
      <% [10, 25, 50, 100, 250, 500].forEach((g) => { %>
        <button type="button" data-add="<%= g %>">+<%= g %></button>
      <% }) %>
    </div>
    <label>Date &amp; time
      <input type="datetime-local" name="filled_at" id="filled_at" required value="<%= form.filled_at || '' %>">
    </label>
    <label>Notes (optional)
      <textarea name="notes" maxlength="2000" placeholder="Meter readings, issues, etc."><%= form.notes || '' %></textarea>
    </label>
  </div>

  <div class="card">
    <h2 style="margin-top:0">BOL photo(s) <span class="muted" style="font-weight:400;font-size:.85rem">(optional, up to 3)</span></h2>
    <p class="muted" style="margin-top:0">Snap a photo of the bill of lading, or pick one from your photo library. Photos are resized automatically before sending.</p>
    <% if (editing && typeof bolDocs !== 'undefined' && bolDocs.length) { %>
      <div style="display:flex;flex-wrap:wrap;gap:.6rem;margin-bottom:.6rem">
        <% bolDocs.forEach((d) => { %>
          <a href="<%= docBase %>/<%= editing.id %>/documents/<%= d.id %>" target="_blank" rel="noopener">
            <img src="<%= docBase %>/<%= editing.id %>/documents/<%= d.id %>" alt="BOL photo"
                 style="width:120px;height:90px;object-fit:cover;border:1px solid var(--line);border-radius:8px;background:#f5f5f5">
          </a>
        <% }) %>
      </div>
      <p class="muted" style="font-size:.85rem"><%= bolDocs.length %> photo(s) already attached — you can add more below (3 total max).</p>
    <% } %>
    <label>Add BOL photo(s)
      <input type="file" name="bol_photos" accept="image/*" multiple></label>
  </div>

  <button class="btn-primary btn-block" type="submit" style="font-size:1.2rem;padding:1rem"><%= editing ? 'Save changes' : 'Save fill' %></button>
  <% if (editing) { %><p style="text-align:center"><a href="<%= cancelUrl %>">Cancel</a></p><% } %>
</form>

<script src="/js/photo-compress.js"></script>
<script>
(function () {
  // Compress BOL photos on the phone before sending (shared helper).
  compressPhotosOnSubmit('fillform');

  var cust = document.getElementById('customer'),
      site = document.getElementById('site'),
      eq = document.getElementById('equipment'),
      gal = document.getElementById('gallons'),
      ft = document.getElementById('fueltype'),
      cfw = document.getElementById('customfuelwrap');
  function filterSites() {
    var c = cust.value;
    Array.prototype.forEach.call(site.options, function (o) {
      if (!o.value) { o.hidden = false; return; }
      o.hidden = !!(c && o.getAttribute('data-customer') !== c);
    });
    if (site.selectedOptions[0] && site.selectedOptions[0].hidden) site.value = '';
  }
  cust.addEventListener('change', filterSites); filterSites();
  function dismissChip(x) {
    var chip = x.closest('.chip');
    var body = new URLSearchParams();
    body.set('_csrf', '<%= csrfToken %>');
    body.set('kind', x.getAttribute('data-kind'));
    body.set('value', x.getAttribute('data-val'));
    fetch('/driver/fills/suggestions/dismiss', { method: 'POST', body: body })
      .then(function (r) { if (r.ok && chip) chip.remove(); })
      .catch(function () { /* offline — chip stays; it can be removed next time */ });
  }
  document.getElementById('eqchips')?.addEventListener('click', function (e) {
    var x = e.target.closest('[data-del]'); if (x) { dismissChip(x); return; }
    var b = e.target.closest('[data-eq]'); if (b) eq.value = b.getAttribute('data-eq');
  });
  document.getElementById('bolchips')?.addEventListener('click', function (e) {
    var x = e.target.closest('[data-del]'); if (x) { dismissChip(x); return; }
    var b = e.target.closest('[data-bol]'); if (b) document.getElementById('bolnumber').value = b.getAttribute('data-bol');
  });
  document.getElementById('galpad').addEventListener('click', function (e) {
    var b = e.target.closest('[data-add]'); if (!b) return;
    var cur = parseFloat(gal.value) || 0;
    gal.value = (cur + parseFloat(b.getAttribute('data-add'))).toFixed(2).replace(/\.00$/, '');
  });
  ft.addEventListener('change', function () {
    cfw.style.display = ft.value === '__custom' ? 'block' : 'none';
  });

  // New fills: default the date/time to the phone's local clock. The server
  // stores the wall clock exactly as typed (and every view shows it as-is),
  // so the phone's local time is the right default on every device.
  (function () {
    var dt = document.getElementById('filled_at');
    if (!dt || dt.value) return;
    <% if (!editing) { %>
    var n = new Date();
    function p(x) { return String(x).padStart(2, '0'); }
    dt.value = n.getFullYear() + '-' + p(n.getMonth() + 1) + '-' + p(n.getDate()) +
               'T' + p(n.getHours()) + ':' + p(n.getMinutes());
    <% } %>
  })();

  // GPS: capture the phone's location when a new fill is logged. Optional —
  // the fill saves fine without it. Skipped when logging on behalf of another
  // driver (their location isn't ours to record).
  (function () {
    var latEl = document.getElementById('fill_lat');
    if (!latEl || !('geolocation' in navigator)) return;
    var lngEl = document.getElementById('fill_lng'),
        accEl = document.getElementById('fill_acc'),
        badge = document.getElementById('gpsbadge'),
        driverSel = document.querySelector('select[name="driver_id"]'),
        me = '<%= user.id %>';
    function eligible() { return !driverSel || String(driverSel.value) === String(me); }
    function clear() {
      latEl.value = ''; lngEl.value = ''; accEl.value = '';
      if (badge) badge.style.display = 'none';
    }
    function capture() {
      if (!eligible()) { clear(); return; }
      navigator.geolocation.getCurrentPosition(function (pos) {
        if (!eligible()) return;
        latEl.value = pos.coords.latitude.toFixed(6);
        lngEl.value = pos.coords.longitude.toFixed(6);
        accEl.value = Math.round(pos.coords.accuracy);
        if (badge) badge.style.display = '';
      }, function () { /* denied or unavailable — fill still saves */ },
      { enableHighAccuracy: true, timeout: 15000, maximumAge: 60000 });
    }
    if (driverSel) driverSel.addEventListener('change', capture);
    capture();
  })();
})();
</script>

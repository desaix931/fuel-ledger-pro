<% const title = 'Log in'; %>
<div class="card narrow">
  <h1>Log in</h1>
  <% if (expired) { %><p class="alert info"><strong>Your session expired.</strong> Sign back in and you&rsquo;ll go straight back to your fill &mdash; everything you entered is saved on your phone.</p><% } %>
  <% if (error) { %><p class="alert err"><%= error %></p><% } %>
  <form method="post" action="/login">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="next" value="<%= next %>">
    <input type="hidden" name="expired" value="<%= expired %>">
    <label>Email
      <input type="email" name="email" required autocomplete="username" inputmode="email">
    </label>
    <label>Password
      <input type="password" name="password" required autocomplete="current-password">
    </label>
    <button class="btn-primary btn-block" type="submit">Log in</button>
  </form>
</div>

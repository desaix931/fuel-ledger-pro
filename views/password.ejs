<% const title = 'Change password'; %>
<h1>Change password</h1>
<% if (error) { %><p class="alert err"><%= error %></p><% } %>
<% if (ok) { %><p class="alert ok"><%= ok %> Your other devices have been signed out.</p><% } %>
<div class="card" style="max-width:28rem">
  <form method="post" action="/password">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Current password
      <input type="password" name="current_password" required autocomplete="current-password">
    </label>
    <label>New password (4–12 characters)
      <input type="password" name="new_password" required minlength="4" maxlength="12" autocomplete="new-password">
    </label>
    <label>Confirm new password
      <input type="password" name="confirm_password" required minlength="4" maxlength="12" autocomplete="new-password">
    </label>
    <p><button class="btn-primary" type="submit">Change password</button></p>
  </form>
</div>

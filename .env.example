# --- Database ---------------------------------------------------------------
# Postgres connection string. On Render this is provided automatically
# via render.yaml (fromDatabase). For local dev, point at your database.
DATABASE_URL=postgres://fuelldgr:devpassword@localhost:5432/fuelledger

# --- Sessions ---------------------------------------------------------------
# Random secret used to sign session cookies.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# --- Seed admin (first boot only) --------------------------------------------
# On first boot, if the users table is empty AND both vars below are set,
# an admin account is created. Afterwards these vars are ignored.
# Change the password immediately after first login (Admin > Users).
ADMIN_EMAIL=office@example.com
ADMIN_PASSWORD=change-me-immediately

# --- Company header (optional; editable later in Admin > Settings) ------------
COMPANY_NAME=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_ADDRESS=

# --- Server ------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Email (optional; enables "Email this ledger" on the ledger page) --------
# If SMTP_HOST is not set, the email form is hidden and nothing breaks.
# Works with any SMTP provider: your company's mail server, Google Workspace
# (app password), SendGrid, Mailgun, etc.
SMTP_HOST=
SMTP_PORT=587
# Set true only for port 465 (implicit TLS). Port 587 uses STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Address the ledger emails are sent FROM (often must match SMTP_USER).
SMTP_FROM=ledgers@example.com

# Who gets emailed when a driver submits the public /apply job-application
# form. Leave empty to default to the company email in Admin > Settings.
APPLY_NOTIFY_EMAIL=
